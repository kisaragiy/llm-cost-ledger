# 上游 LLM 服务（OpenAI 兼容即可）
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=sk-xxx

# 账本
LEDGER_DB=ledger.db
LEDGER_HOST=127.0.0.1
LEDGER_PORT=8790

# 代理自身鉴权（留空 = 不校验，仅建议本机使用）
PROXY_AUTH_KEY=

# 默认归因标签，可被请求头 X-Ledger-User / X-Ledger-Feature 覆盖
LEDGER_DEFAULT_USER=anonymous
LEDGER_DEFAULT_FEATURE=

# 预算规则（JSON 数组）。scope: global|user|feature，window: day|month|rolling_24h|total
# 例：BUDGET_RULES='[{"scope":"global","window":"day","limit_usd":5},
#                    {"scope":"user","key":"alice","window":"day","limit_usd":1}]'
BUDGET_RULES=[]
